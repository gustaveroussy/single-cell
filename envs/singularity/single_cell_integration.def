BootStrap: docker
From: ubuntu:24.04

#build image
#sudo singularity build single_cell_integration.simg single_cell_integration.def &> single_cell_integration.log
#using image
#sudo singularity shell -B local_folder:/WORKDIR/container_folder single_cell_integration.simg
#sudo singularity shell single_cell_integration.simg

%environment
    export PATH=/opt/conda/bin:$PATH
    export RETICULATE_MINICONDA_ENABLED=FALSE
    LANG=en_US.UTF-8
    LC_ALL=en_US.UTF-8
    LC_TIME=en_US.UTF-8
    LC_MONETARY=en_US.UTF-8
    LC_PAPER=en_US.UTF-8
    LC_MEASUREMENT=en_US.UTF-8
    CFLAGS=-I/usr/include/hdf5/serial
    CXXFLAGS=-I/usr/include/hdf5/serial
    LDFLAGS=-L/usr/lib/x86_64-linux-gnu/hdf5/serial

%post
    echo "Ubuntu version ######################"
    cat /etc/lsb-release
    apt-get -y update && apt-get -y upgrade
    
    ln -fs /usr/share/zoneinfo/Europe/Paris /etc/localtime
    apt-get install -y tzdata
    dpkg-reconfigure --frontend noninteractive tzdata
    
    apt-get install -y wget build-essential g++ libcurl4-openssl-dev libssl-dev libxml2-dev libgsl-dev libgit2-dev libpython3-dev libgmp3-dev tzdata libfontconfig1-dev  libharfbuzz-dev libfribidi-dev libharfbuzz-dev libfribidi-dev libfreetype6-dev libpng-dev libtiff5-dev libjpeg-dev libcairo2-dev libxt-dev libgeos-dev libhdf5-dev libhdf5-serial-dev pkg-config build-essential libmagick++-dev libz-dev cmake
    apt-get install -y dirmngr gnupg apt-transport-https ca-certificates software-properties-common
    apt-get -y update && apt-get -y upgrade
    apt-key adv --keyserver hkp://keyserver.ubuntu.com:80 --recv-keys E298A3A825C0D65DFD57CBB651716619E084DAB9
    add-apt-repository 'deb https://cloud.r-project.org/bin/linux/ubuntu noble-cran40/'
    apt-get -y update && apt-get -y upgrade
    apt-get install -y r-base r-base-dev #apt-cache policy r-base r-base-dev pour connaître les versions
    apt install -y default-jre
    echo "java version ######################"
    java --version
    echo "R version ######################"
    R --version
    
    echo "========== Install Miniconda + scVI =========="
    wget https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh -O /tmp/miniconda.sh
    bash /tmp/miniconda.sh -b -p /opt/conda
    rm /tmp/miniconda.sh
    export PATH=/opt/conda/bin:$PATH

    # Accept Anaconda Terms of Service (required)
    conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/main
    conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/r

    # Create environment and install scVI
    conda create -y -n scvi-env python=3.10 -c conda-forge
    conda install -n scvi-env -c conda-forge scanpy
    conda run -n scvi-env pip install --no-cache-dir torch torchvision torchaudio scvi-tools==1.1.2
    conda run -n scvi-env pip install "jax[cpu]==0.4.28"
    conda run -n scvi-env python -c "import scvi; print('scVI version:', scvi.__version__)"
    #environment is located here: /opt/conda/envs/scvi-env
    
    echo "Install R packages ######################"

    echo "Install Global packages ######################"
    R -e 'install.packages("devtools")'
    R -e 'library("devtools")'
    R -e 'install.packages("BiocManager")'
    R -e 'install.packages(c("sp", "future", "future.apply", "progressr", "spam", "generics", "RcppEigen","cowplot", "fastDummies", "fitdistrplus", "ggplot2", "ggrepel", "ggridges", "httr", "ica", "igraph", "irlba", "leiden", "lmtest", "matrixStats", "patchwork", "pbapply", "plotly", "png", "progressr", "RANN", "RColorBrewer", "RcppAnnoy", "RcppHNSW", "reticulate", "ROCR", "RSpectra", "Rtsne", "scales", "scattermore", "sctransform", "spatstat.explore", "spatstat.geom", "uwot", "RcppProgress"), repos="https://cloud.r-project.org")'
    #R -e 'install.packages("Seurat")'
    R -e 'install.packages("remotes", repos="https://cloud.r-project.org")'
    R -e 'remotes::install_version("SeuratObject", version="5.0.1", repos="https://cloud.r-project.org", dependencies=FALSE)'
    R -e 'remotes::install_version("Seurat", version="5.0.1", repos="https://cloud.r-project.org", dependencies=FALSE)'
    R -e 'library(Seurat)'
    echo "Seurat==5.0.1" >> /usr/local/lib/R/site-library/.Rpackages.lock
    export CFLAGS=-I/usr/include/hdf5/serial
    export CXXFLAGS=-I/usr/include/hdf5/serial
    export LDFLAGS=-L/usr/lib/x86_64-linux-gnu/hdf5/serial
    mkdir ~/.R
    echo "CFLAGS=-I/usr/include/hdf5/serial" > ~/.R/Makevars
    echo "CXXFLAGS=-I/usr/include/hdf5/serial" >> ~/.R/Makevars
    echo "LDFLAGS=-L/usr/lib/x86_64-linux-gnu/hdf5/serial" >> ~/.R/Makevars
    R -e 'setRepositories(ind = 1:3, addURLs = c("https://satijalab.r-universe.dev", "https://bnprks.r-universe.dev/"));install.packages(c("BPCells", "presto", "glmGamPoi"))'
    R -e 'library(BPCells)'
    R -e 'install.packages(c("RcppParallel", "RSpectra", "irlba", "uwot"))'
    R -e 'BiocManager::install("byteme", ask = FALSE, update = TRUE)'
    R -e 'BiocManager::install("alabaster.base")'
    R -e 'install.packages(c("bluster", "leiden"))'
    R -e 'devtools::install_github("thomasp85/patchwork")'
    R -e 'install.packages("optparse")'
    R -e 'install.packages("Matrix")'
    R -e 'install.packages("doParallel")'
    R -e 'BiocManager::install("BiocParallel")'
    R -e 'install.packages("ggplot2")'
    R -e 'install.packages("stringr")'
    R -e 'install.packages("future")'
    R -e 'install.packages("openxlsx")' #launch
    R -e 'install.packages("utils")' #launch
    R -e 'install.packages("readxl")' #launch
    R -e 'install.packages("readr")'
    R -e 'install.packages("testthat", dependencies = TRUE)'
    R -e 'BiocManager::install("scran")'
    R -e 'install.packages("mixhvg")'

    echo "Install Integration packages ######################"
    R -e 'install.packages("remotes")'
    R -e 'BiocManager::install("HDF5Array")' #for rliger
    R -e 'install.packages("rliger")'
    R -e 'install.packages("R.utils")' #for seurat-wrappers
    R -e 'remotes::install_github("satijalab/seurat-wrappers")'
    R -e 'BiocManager::install("batchelor")' #for FastMNNIntegration
    R -e 'BiocManager::install("SingleCellExperiment")' #for harmony
    R -e 'install.packages("harmony")'

    echo "Install params packages ######################"
    R -e 'install.packages("rjson")' #load

    echo "Install Normalization + dimension reduction + correction of bias + evaluation of bias and clustering parameters packages ######################"
    R -e 'BiocManager::install("DESeq2")' # for scBFA
    R -e 'devtools::install_github("quon-titative-biology/scBFA")' # red dim + eval_red_dim
    R -e 'install.packages("scales")' # eval.redim
    R -e 'install.packages("matrixStats")' # red dim
    R -e 'install.packages("RColorBrewer")' # eval.redim
    R -e 'install.packages("foreach")' # clustering.eval.mt
    R -e 'install.packages("clustree")' # clustering.eval.mt

    echo "Install Clustering + Annotations + Markers + Plots ######################"
    R -e 'install.packages("methods")' # annotation
    R -e 'BiocManager::install("celldex")' # annotation
    R -e 'BiocManager::install("scRNAseq")' # annotation
    R -e 'BiocManager::install("SingleR")' # annotation
    R -e 'BiocManager::install("scrapper")' # annotation
    R -e 'BiocManager::install("SingleCellExperiment")' # annotation
    R -e 'BiocManager::install("clustifyr")' # annotation
    R -e 'BiocManager::install("clustifyrdatahub")' # annotation
    R -e 'remotes::install_github("rnabioco/clustifyrdata")' # annotation
    R -e 'BiocManager::install("CelliD")' # annotation
    R -e 'install.packages("pheatmap")' # annotation
    R -e 'install.packages("ggplotify")' # annotation
    R -e 'install.packages("UpSetR")' # Markers
    R -e 'BiocManager::install("UCell")' # Score Markers
    R -e 'install.packages("GSVA")' # Markers
    
    echo "========== FINAL STEP: Seurat 5.0.1 =========="
    R -e 'remove.packages(c("Seurat","SeuratObject")); remotes::install_version("SeuratObject", version="5.0.1", repos="https://cloud.r-project.org", dependencies=FALSE); remotes::install_version("Seurat", version="5.0.1", repos="https://cloud.r-project.org", dependencies=FALSE); cat("Seurat version: ", as.character(packageVersion("Seurat")), "\n")'


%labels
    Author Marine AGLAVE
