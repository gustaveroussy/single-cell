BootStrap: docker
From: ubuntu:24.04

#build image
#sudo singularity build single_cell_kallisto_bustools.simg single_cell_kallisto_bustools.def &> single_cell_kallisto_bustools.log
#using image
#sudo singularity shell --no-home -B local_folder:/WORKDIR/container_folder single_cell_kallisto_bustools.simg

%help
This is a singularity container to run single-cell pipeline version 1.4 from Gustave Roussy Bioinformatics Core Facility.
This singularity container is specific to run kallisto and bustools for GE and ADT libraries.

%environment
    export PATH=/opt/tools/bin:$PATH
    LANG=en_US.UTF-8
    LANGUAGE=en_US.UTF-8
    LC_ALL=en_US.UTF-8
    LC_TIME=en_US.UTF-8
    LC_PAPER=en_US.UTF-8
    LC_MEASUREMENT=en_US.UTF-8
    
%files
    /home/m_aglave/Bureau/single-cell-dev/resources/WHITELISTS /resources/

%post
    echo "Ubuntu version ######################"
    cat /etc/lsb-release
    apt-get -y update && apt-get -y upgrade
    apt-get install -y unzip wget zlib1g-dev
    DEBIAN_FRONTEND=noninteractive TZ=Etc/UTC apt-get -y install tzdata
    apt-get install -y build-essential
    
    mkdir /softwares/
    cd /softwares
    
    echo "### kallisto ###"
    apt-get install -y kallisto
    #using: kallisto
    
    echo "### bustools ###"
    apt-get install -y cmake
    wget https://github.com/BUStools/bustools/archive/refs/heads/master.zip
    unzip master.zip -d .
    rm master.zip
    mv bustools-master bustools
    cd bustools
    mkdir build
    cd build
    cmake ..
    make
    make install
    #using: bustools
    
%labels
    Author Marine AGLAVE
